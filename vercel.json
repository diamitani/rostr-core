{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.py,agents/**,config.json,skills/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api?__path=/" },
    { "source": "/:path*", "destination": "/api?__path=/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
