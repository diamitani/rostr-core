{
  "gateway": {
    "api_key_env": "AI_GATEWAY_API_KEY",
    "base_url": "https://ai-gateway.vercel.sh/v1",
    "cheap_model": "anthropic/claude-haiku-4-5",
    "background_model": "anthropic/claude-haiku-4-5",
    "default_model": "anthropic/claude-sonnet-4-6",
    "frontier_model": "anthropic/claude-sonnet-4-6",
    "timeout_s": 120
  },
  "hub": { "dir": ".rostr" },
  "runtime": {
    "max_steps_per_worker": 12,
    "mock_mode_env": "ROSTR_MOCK",
    "harness": "jev"
  },
  "tools": {
    "allow": ["read_file", "write_file", "list_dir"],
    "deny": ["email:send", "shell:exec"],
    "require_approval": []
  }
}
