{
  "gateway": {
    "api_key_env": "AI_GATEWAY_API_KEY",
    "oidc_env": "VERCEL_OIDC_TOKEN",
    "xai_key_env": "XAI_API_KEY",
    "base_url": "https://ai-gateway.vercel.sh/v1",
    "xai_base_url": "https://api.x.ai/v1",
    "frontier_model": "spacexai/grok-4.5",
    "subagent_model": "anthropic/claude-sonnet-4.6",
    "cheap_model": "google/gemini-3.1-flash-lite",
    "background_model": "google/gemini-2.5-flash-lite",
    "default_model": "spacexai/grok-4.5",
    "timeout_s": 120
  },
  "hub": { "dir": ".rostr" },
  "runtime": {
    "max_steps_per_worker": 12,
    "mock_mode_env": "ROSTR_MOCK",
    "harness": "jev"
  },
  "tools": {
    "allow": ["read_file", "write_file", "list_dir"],
    "deny": ["email:send", "shell:exec"],
    "require_approval": []
  }
}
